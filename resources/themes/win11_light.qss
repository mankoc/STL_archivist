/* Windows 11 Light (Fluent Design) theme for STL Database */

/* ================================================================
   Color tokens
   --bg-base:       #f3f3f3   window / mica base
   --bg-surface:    #ffffff   card / panel surface
   --bg-control:    #fbfbfb   control fill (button, input, combo)
   --bg-hover:      #f0f0f0   control fill on hover
   --bg-pressed:    #e5e5e5   control fill on press
   --border:        #d1d1d1   subtle border
   --border-focus:  #0067c0   focus ring
   --accent:        #0067c0   Windows blue
   --accent-hover:  #1576c7
   --accent-press:  #0050a0
   --text-primary:  #1b1b1b
   --text-secondary:#6b6b6b
   --text-disabled: #a0a0a0
   --selection:     #cce4f7
   --pair-a:        #c8e0f4   duplicate-pair highlight A (blue tint)
   --pair-b:        #e4d0f0   duplicate-pair highlight B (purple tint)
================================================================ */

/* ---- Base ---- */
QWidget {
    background-color: #f3f3f3;
    color: #1b1b1b;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
    border: none;
}

QMainWindow {
    background-color: #f3f3f3;
}

QDialog {
    background-color: #f3f3f3;
}

/* ---- Menu bar ---- */
QMenuBar {
    background-color: #f3f3f3;
    color: #1b1b1b;
    padding: 2px 0;
    spacing: 0;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e5e5e5;
}

QMenuBar::item:pressed {
    background-color: #d8d8d8;
}

/* ---- Menus ---- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    color: #1b1b1b;
    border-radius: 4px;
    min-width: 140px;
}

QMenu::item:selected {
    background-color: #e8e8e8;
}

QMenu::item:disabled {
    color: #a0a0a0;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #f3f3f3;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    spacing: 2px;
    padding: 4px 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #d1d1d1;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #1b1b1b;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
}

QToolButton:hover {
    background-color: #e8e8e8;
    border-color: #d1d1d1;
}

QToolButton:pressed {
    background-color: #d8d8d8;
    border-color: #c0c0c0;
}

QToolButton:checked {
    background-color: #cce4f7;
    border-color: #0067c0;
}

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid #d8d8d8;
    border-radius: 0 0 6px 6px;
    background-color: #f3f3f3;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #6b6b6b;
    padding: 7px 20px;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}

QTabBar::tab:selected {
    color: #1b1b1b;
    border-bottom: 2px solid #0067c0;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: #1b1b1b;
    background-color: #ebebeb;
    border-bottom: 2px solid #b0b0b0;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #fbfbfb;
    color: #1b1b1b;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 5px 16px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #f0f0f0;
    border-color: #b0b0b0;
}

QPushButton:pressed {
    background-color: #e5e5e5;
    border-color: #a0a0a0;
    color: #3a3a3a;
}

QPushButton:default {
    background-color: #0067c0;
    color: #ffffff;
    border-color: #0067c0;
}

QPushButton:default:hover {
    background-color: #1576c7;
    border-color: #1576c7;
}

QPushButton:default:pressed {
    background-color: #0050a0;
    border-color: #0050a0;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #d8d8d8;
}

/* ---- Inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 5px 8px;
    color: #1b1b1b;
    selection-background-color: #0067c0;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #a0a0a0;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #8fbce0;
    border-bottom: 2px solid #0067c0;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #d8d8d8;
}

/* ---- SpinBox ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 5px 8px;
    color: #1b1b1b;
    min-height: 28px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #a0a0a0;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #8fbce0;
    border-bottom: 2px solid #0067c0;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: transparent;
    border: none;
    border-left: 1px solid #c8c8c8;
    border-bottom: 1px solid #c8c8c8;
    width: 18px;
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    border-left: 1px solid #c8c8c8;
    width: 18px;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e8e8e8;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(%(ICONS_DIR)s/arrow_up_light.svg);
    width: 7px;
    height: 7px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(%(ICONS_DIR)s/arrow_down_light.svg);
    width: 7px;
    height: 7px;
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    padding: 5px 8px;
    color: #1b1b1b;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #a0a0a0;
}

QComboBox:focus {
    border-color: #8fbce0;
    border-bottom: 2px solid #0067c0;
}

QComboBox:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border-color: #d8d8d8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    border-left: 1px solid #c8c8c8;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(%(ICONS_DIR)s/arrow_down_light.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    selection-background-color: #e8e8e8;
    selection-color: #1b1b1b;
    color: #1b1b1b;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 5px 8px;
    border-radius: 4px;
    min-height: 24px;
}

/* ---- Table ---- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    gridline-color: #e8e8e8;
    border: 1px solid #d1d1d1;
    selection-background-color: #cce4f7;
    selection-color: #1b1b1b;
    outline: none;
}

QTableView::item, QTableWidget::item {
    padding: 2px 4px;
    border: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #cce4f7;
    color: #1b1b1b;
}

QTableView::item:hover:!selected, QTableWidget::item:hover:!selected {
    background-color: #f0f0f0;
}

QHeaderView {
    background-color: #f3f3f3;
    border: none;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #6b6b6b;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #e0e0e0;
    border-bottom: 2px solid #d0d0d0;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:first {
    border-left: none;
}

QHeaderView::section:hover {
    background-color: #e8e8e8;
    color: #1b1b1b;
}

QHeaderView::up-arrow {
    image: url(%(ICONS_DIR)s/arrow_up_light.svg);
    width: 10px;
    height: 6px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    margin-right: 4px;
}

QHeaderView::down-arrow {
    image: url(%(ICONS_DIR)s/arrow_down_light.svg);
    width: 10px;
    height: 6px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    margin-right: 4px;
}

/* ---- Tree ---- */
QTreeWidget {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #d1d1d1;
    outline: none;
}

QTreeWidget::item {
    padding: 4px 4px;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #f0f0f0;
}

QTreeWidget::item:selected {
    background-color: #cce4f7;
    color: #1b1b1b;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(%(ICONS_DIR)s/branch_closed_light.svg);
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(%(ICONS_DIR)s/branch_open_light.svg);
}

/* ---- Group box ---- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 8px 8px 8px;
    color: #6b6b6b;
    font-weight: 600;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #6b6b6b;
    background-color: #ffffff;
}

/* ---- CheckBox ---- */
QCheckBox {
    color: #1b1b1b;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b0b0b0;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0067c0;
    background-color: #f0f0f0;
}

QCheckBox::indicator:checked {
    background-color: #0067c0;
    border-color: #0067c0;
}

QCheckBox::indicator:checked:hover {
    background-color: #1576c7;
    border-color: #1576c7;
}

QCheckBox:disabled {
    color: #a0a0a0;
}

QCheckBox::indicator:disabled {
    background-color: #f5f5f5;
    border-color: #d0d0d0;
}

/* ---- RadioButton ---- */
QRadioButton {
    color: #1b1b1b;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b0b0b0;
    border-radius: 8px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #0067c0;
}

QRadioButton::indicator:checked {
    background-color: #0067c0;
    border-color: #0067c0;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #e8e8e8;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    text-align: center;
    color: #1b1b1b;
    min-height: 6px;
}

QProgressBar::chunk {
    background-color: #0067c0;
    border-radius: 3px;
}

/* ---- Scroll bars ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 24px;
    margin: 2px 2px 2px 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #888888;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-width: 24px;
    margin: 4px 2px 2px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #888888;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- Labels ---- */
QLabel {
    background-color: transparent;
    color: #1b1b1b;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #e0e0e0;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #0067c0;
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: #0067c0;
    color: #ffffff;
    font-size: 12px;
}

QStatusBar QLabel {
    color: #ffffff;
    background: transparent;
}

QStatusBar::item {
    border: none;
}

/* ---- Tooltip ---- */
QToolTip {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    color: #1b1b1b;
    padding: 5px 8px;
    border-radius: 4px;
}

/* ---- Scroll area ---- */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---- Frame ---- */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #d1d1d1;
}

/* ---- Dialog buttons ---- */
QDialogButtonBox QPushButton {
    min-width: 80px;
}
